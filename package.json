{
  "name": "local-soundboard",
  "version": "1.2.0",
  "description": "Local streamer soundboard — trigger sounds from your phone onto the streaming PC",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "app": "electron .",
    "generate-demos": "node scripts/generate-demos.js",
    "pack:win": "electron-builder --win zip --x64",
    "pack:win:portable-node": "node scripts/prepare-windows-dist.js"
  },
  "engines": {
    "node": ">=18"
  },
  "build": {
    "appId": "com.localsoundboard.app",
    "productName": "Local Soundboard",
    "directories": {
      "output": "dist-app",
      "buildResources": "electron/build"
    },
    "files": [
      "electron/main.js",
      "server.js",
      "public/**/*",
      "sounds/**/*",
      "data/**/*",
      "package.json",
      "node_modules/**/*",
      "!node_modules/electron/**",
      "!node_modules/electron-builder/**",
      "!node_modules/app-builder-bin/**",
      "!dist/**",
      "!dist-app/**",
      "!.cache/**"
    ],
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": ["x64"]
        }
      ],
      "icon": "public/icons/icon-512.png",
      "artifactName": "LocalSoundboard-Windows-${version}.${ext}"
    },
    "asar": true
  },
  "dependencies": {
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  }
}
