{
  "name": "local-soundboard",
  "version": "1.1.0",
  "description": "Local streamer soundboard — trigger sounds from your phone onto the streaming PC",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "generate-demos": "node scripts/generate-demos.js",
    "build:win": "pkg . --targets node18-win-x64 --output dist/LocalSoundboard.exe",
    "pack:win": "npm run build:win && node scripts/prepare-windows-dist.js"
  },
  "engines": {
    "node": ">=18"
  },
  "pkg": {
    "assets": [
      "public/**/*",
      "node_modules/socket.io/client-dist/**/*"
    ],
    "scripts": [
      "server.js"
    ],
    "outputPath": "dist"
  },
  "dependencies": {
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  }
}
